# =============================================================================
# High Jump Biomechanical Analysis — .gitignore
# =============================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/
*.so

# ---- Virtual Environments ----
.venv/
venv/
env/
ENV/

# ---- IDE ----
.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Data (large files — don't commit to git) ----
data/videos/raw/*
data/videos/processed/*
data/poses/landmarks_2d/*
data/poses/landmarks_3d/*
data/bvh/*
data/parameters/*
data/models/population/*
data/models/personal/*
data/models/mediapipe/*
data/calibration/*
data/public/*
data/High Jump Videos/
!data/**/.gitkeep

# ---- Analysis results (generated, can be reproduced) ----
data/results/

# ---- Experiment outputs ----
experiments/results/*
!experiments/results/.gitkeep

# ---- OpenSim temp artifacts ----
opensim.log
_ik_marker_errors.sto

# ---- Notebook checkpoints ----
.ipynb_checkpoints/
notebooks/*.html

# ---- PyTorch / ML artifacts ----
*.pth
*.pt
*.ckpt
*.onnx
wandb/
mlruns/
lightning_logs/

# ---- Scratch / backup scripts ----
scripts/*_backup.py
scripts/quick_check.py

# ---- Environment ----
.env
.env.local

# ---- OS ----
.DS_Store
Desktop.ini

# ---- Agent / prompt / onboarding files (local AI tooling) ----
.github/agents/
.github/prompts/
.github/copilot-instructions.md
AGENTS.md
CLAUDE_ONBOARDING.md

# ---- Local RAG memory artifacts ----
memory/vector_index/
memory/logs/*.jsonl
memory/logs/*.log
!memory/logs/.gitkeep

# ---- Athlete private data ----
imogens_response- to-questions/
questions to imogen.md
EMAIL_FOR_IMOGEN.md

# ---- Private business/strategy notes ----
business/
potential valuation.md
